{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--no-usage-statistics"
        ]
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "CONTEXT7_API_KEY": "[ENCRYPTION_KEY]"
        }
      }
    }
  },
  "agents": {
    "title": {
      "model": "opencode/deepseek-v4.1-flash-free"
    }
  }
}
