# Zona horaria de Reynosa (frontera: horario de verano como EUA)
TZ=America/Matamoros
PUERTO_WEB=8080
DB_NAME=delgrow_contadores
DB_USER=delgrow_app
DB_PASSWORD=cambiar_por_una_clave_larga
DB_ROOT_PASSWORD=cambiar_por_otra_clave_larga
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=generar_con_el_comando_de_arriba
JWT_EXPIRES_IN=2h
SESSION_INACTIVITY_MINUTES=30
# Cada dirección exacta con la que se abrirá la app en el navegador
CORS_ORIGENES=http://localhost:8080,http://192.168.1.50:8080
