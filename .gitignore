# Dependencies
node_modules

# Environment files
.env
.env.*

# Logs
*.log
npm-debug.log*
yarn-debug.log*
dist/
build/

# OS files
.DS_Store
Thumbs.db

# Misc
*.tmp
*.temp

# Datos personales de cuentas reales (nombres, correos, contraseñas): nunca se suben
*.xlsx
*.local.json

# Plantilla de variables de Docker (sin claves reales)
!.env.example

# Respaldos de la base: tienen hashes de contraseñas, nunca se suben
*.sql

# Herramientas locales: configuración de los servidores de prueba y skills de diseño instaladas aquí
.claude/launch.json
.agents/skills/impeccable/
.agents/skills/emil-design-eng/
.claude/skills/impeccable/
.claude/skills/emil-design-eng/

# Grafo generado por la skill graphify (se reconstruye a partir del código)
graphify-out/

# Respaldos cifrados de la base (se guardan fuera del proyecto)
*.sql.cifrado
